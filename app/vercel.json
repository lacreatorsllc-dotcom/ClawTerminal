{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npx expo export --platform web && node scripts/patch-web-fonts.js",
  "outputDirectory": "dist",
  "framework": null,
  "routes": [
    {
      "src": "/",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" },
      "continue": true
    },
    {
      "src": "/index\\.html",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" },
      "continue": true
    },
    {
      "src": "/_expo/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/favicon\\.(png|ico|svg)",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/" }
  ]
}
