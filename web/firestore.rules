rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Waitlist — public write, no read
    match /waitlist/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // User profiles — own profile read/write; other authed users can read public fields
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Following edges — any signed-in user may read (social graph, follower counts via
    // collectionGroup queries). Only the follower (path uid) may create/delete their edge.
    match /users/{uid}/following/{targetUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Usernames — readable by any authed user (uniqueness checks), writable by owner
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Slug #001 — readable by any authed user, written only by backend (service account)
    match /agents/slug-001 {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /agents/slug-001/{subcollection}/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User agents — any signed-in user can read top-level agent docs (search, public profile).
    // Secrets live in private/ (owner-only). Owner-only: create / update / delete.
    match /agents/{agentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // Credentials & API keys — only the agent owner may read or write.
    match /agents/{agentId}/private/{doc} {
      allow read, create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/agents/$(agentId)).data.user_id == request.auth.uid;
    }

    // Chat messages — owner (or any authed user for shared slug-001) may read/create.
    // Owner may update only to set chat_processed (idempotent claim for client + bridge).
    match /agents/{agentId}/messages/{msgId} {
      allow read: if request.auth != null && (
        agentId == 'slug-001' ||
        get(/databases/$(database)/documents/agents/$(agentId)).data.user_id == request.auth.uid
      );
      allow create: if request.auth != null && (
        agentId == 'slug-001' ||
        get(/databases/$(database)/documents/agents/$(agentId)).data.user_id == request.auth.uid
      );
      allow update: if request.auth != null && (
        agentId == 'slug-001' ||
        (
          get(/databases/$(database)/documents/agents/$(agentId)).data.user_id == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chat_processed']) &&
          request.resource.data.chat_processed == true
        )
      );
      allow delete: if false;
    }

    match /agents/{agentId}/{subcollection}/{doc} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/agents/$(agentId)).data.user_id == request.auth.uid
      );
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/agents/$(agentId)).data.user_id == request.auth.uid
      );
      allow update, delete: if false;
    }

    // Feed events — all authed users can read; users can write their own public PnL posts
    match /feed_events/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Agent type instances (range farmer etc) — readable by authed users
    match /agent_types/{type}/instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

  }
}

