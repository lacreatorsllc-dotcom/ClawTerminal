rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Waitlist — public write, no read
    match /waitlist/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // User profiles — own profile read/write; other authed users can read public fields
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Following subcollection — only the owner can read/write their own follows
    match /users/{uid}/following/{targetUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Usernames — readable by any authed user (uniqueness checks), writable by owner
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Slug #001 — readable by any authed user, written only by backend (service account)
    match /agents/slug-001 {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /agents/slug-001/{subcollection}/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User agents — owner can read/write; subcollections (messages, decisions) same
    match /agents/{agentId} {
      allow read: if request.auth != null && (
        resource.data.user_id == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
    match /agents/{agentId}/{subcollection}/{doc} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/agents/$(agentId)).data.user_id == request.auth.uid
      );
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/agents/$(agentId)).data.user_id == request.auth.uid
      );
      allow update, delete: if false;
    }

    // Feed events — all authed users can read; users can write their own public PnL posts
    match /feed_events/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Agent type instances (range farmer etc) — readable by authed users
    match /agent_types/{type}/instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

  }
}

